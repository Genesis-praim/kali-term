<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KaliTerm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="android:statusBarColor">@color/bg_black</item>
        <item name="android:navigationBarColor">@color/bg_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Estilo compartido de los botones flotantes de teclas -->
    <style name="ExtraKey">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
