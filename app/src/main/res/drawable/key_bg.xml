<?xml version="1.0" encoding="utf-8"?>
<!-- Botón flotante estilo terminal hacker: relleno translúcido + borde neón -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_green_glow" />
            <stroke android:width="1.5dp" android:color="@color/neon_green" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_green_glow" />
            <stroke android:width="1.5dp" android:color="@color/neon_green" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_fill" />
            <stroke android:width="1dp" android:color="@color/neon_green_dim" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
